{
  "name": "@ktb-tools/scanner",
  "version": "0.2.0",
  "private": false,
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist",
    "src",
    "scripts",
    "third-party",
    "tsconfig.build.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./scanic": {
      "types": "./dist/scanic.d.ts",
      "import": "./dist/scanic.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    },
    "./ocr": {
      "types": "./dist/ocr.d.ts",
      "import": "./dist/ocr.js"
    },
    "./styles.css": "./dist/styles.css",
    "./assets/*": "./dist/assets/*"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "pdf-lib": "1.17.1",
    "scanic": "1.7.1"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "description": "Embeddable document-scanning workflow built on Scanic, with a customizable React UI, reversible image processing and browser-side image/PDF export",
  "repository": {
    "type": "git",
    "url": "https://github.com/kbudisantoso/ktb.scanner.git",
    "directory": "packages/scanner"
  },
  "homepage": "https://github.com/kbudisantoso/ktb.scanner#readme",
  "bugs": {
    "url": "https://github.com/kbudisantoso/ktb.scanner/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
