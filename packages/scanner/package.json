{
  "name": "@ktb/scanner",
  "version": "0.1.0",
  "private": false,
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist",
    "src",
    "scripts",
    "tsconfig.build.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./scanic": {
      "types": "./dist/scanic.d.ts",
      "import": "./dist/scanic.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    },
    "./styles.css": "./dist/styles.css",
    "./assets/*": "./dist/assets/*"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "scanic": "1.7.1",
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "description": "Embeddable browser document scanner with React, local image processing and PDF export",
  "repository": {
    "type": "git",
    "url": "https://github.com/kbudisantoso/ktb.scanner.git",
    "directory": "packages/scanner"
  },
  "homepage": "https://github.com/kbudisantoso/ktb.scanner#readme",
  "bugs": {
    "url": "https://github.com/kbudisantoso/ktb.scanner/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
