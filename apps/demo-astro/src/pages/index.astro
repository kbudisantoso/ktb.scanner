---
import '@ktb/scanner/styles.css';
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Scanner / Astro Beispiel</title></head><body><main><p class="eyebrow" data-i18n="Astro Integration">Astro Integration</p><h1><span data-i18n="Ein Scanner.">Ein Scanner.</span><br /><span data-i18n="Deine Oberfläche.">Deine Oberfläche.</span></h1><p class="intro" data-i18n="Dieselbe Bibliothek in einem anderen Host. React und der Scanner werden erst beim Öffnen geladen.">Dieselbe Bibliothek in einem anderen Host. React und der Scanner werden erst beim Öffnen geladen.</p><label><span data-i18n="Sprache">Sprache</span> <select id="language" aria-label="Sprache / Language"><option value="de">Deutsch</option><option value="en">English</option></select></label><div class="actions"><button id="open" data-i18n="Dokument scannen">Dokument scannen</button><button id="import" data-i18n="Bild importieren">Bild importieren</button></div><input id="file" type="file" accept="image/jpeg,image/png,image/webp" multiple hidden /><p id="status" role="status">Bilder und PDF bleiben lokal in dieser Sitzung.</p><section id="results" aria-label="Scanergebnisse"></section><button id="reset" data-i18n="Ergebnisse zurücksetzen" hidden>Ergebnisse zurücksetzen</button><div id="scanner-mount"></div></main><script src="../client.ts"></script></body></html>
<style is:global>
  body{margin:0;background:#f0eef5;color:#302d42;font:17px/1.6 system-ui,sans-serif}main{max-width:960px;margin:0 auto;padding:70px 26px}.eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#625778}h1{font:500 clamp(40px,7vw,74px)/1.1 Georgia,serif;letter-spacing:-.04em;margin:24px 0}.intro{max-width:580px;color:#625b71}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:30px 0}button,a.download{font:inherit;background:#594a93;color:#fff;border:0;border-radius:5px;padding:12px 20px;min-height:46px;cursor:pointer;text-decoration:none}select{font:inherit;min-height:44px;max-width:100%}button:disabled{opacity:.5}button:focus-visible,a:focus-visible,select:focus-visible{outline:3px solid #9e5728;outline-offset:4px}#status{font-size:14px}#results{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:22px;margin:32px 0}#results article{padding:20px;background:#fff}#results img{width:100%;height:250px;object-fit:contain}#results a{display:block;margin-top:12px}#reset[hidden]{display:none}
</style>
