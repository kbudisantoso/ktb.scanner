---
import '@ktb-tools/scanner/styles.css';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Scanner / Astro example</title></head><body><main><p class="eyebrow" data-i18n="Astro Integration">Astro integration</p><h1><span data-i18n="Ein Scanner.">One scanner.</span><br /><span data-i18n="Deine Oberfläche.">Your interface.</span></h1><p class="intro" data-i18n="Dieselbe Bibliothek in einem anderen Host. React und der Scanner werden erst beim Öffnen geladen.">The same library in another host. React and the scanner load only when opened.</p><label><span data-i18n="Sprache">Language</span> <select id="language" aria-label="Sprache / Language"><option value="en">English</option><option value="de">Deutsch</option></select></label><label><span data-i18n="Aufnahmeablauf">Capture workflow</span> <select id="capture-workflow" aria-label="Capture workflow"><option value="continuous" data-i18n="Mehrere Seiten aufnehmen">Capture multiple pages</option><option value="review-each" data-i18n="Nach jeder Aufnahme prüfen">Review after each capture</option></select></label><div class="actions"><button id="open" data-i18n="Dokument scannen">Scan document</button><button id="import" data-i18n="Bild importieren">Import image</button></div><input id="file" type="file" accept="image/jpeg,image/png,image/webp" multiple hidden /><p id="status" role="status">Images and PDF stay local to this session.</p><section id="results" aria-label="Scan results"></section><button id="reset" data-i18n="Ergebnisse zurücksetzen" hidden>Reset results</button><p><a href="/third-party-notices.txt" target="_blank" rel="noreferrer" data-i18n="Lizenzen">Licenses</a> · <a href="https://github.com/kbudisantoso/ktb.scanner" target="_blank" rel="noreferrer" data-i18n="Quellcode">Source code</a></p><div id="scanner-mount"></div></main><script src="../client.ts"></script></body></html>
<style is:global>
  body{margin:0;background:#f0eef5;color:#302d42;font:17px/1.6 system-ui,sans-serif}main{max-width:960px;margin:0 auto;padding:70px 26px}.eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#625778}h1{font:500 clamp(40px,7vw,74px)/1.1 Georgia,serif;letter-spacing:-.04em;margin:24px 0}.intro{max-width:580px;color:#625b71}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:30px 0}button,a.download{font:inherit;background:#594a93;color:#fff;border:0;border-radius:5px;padding:12px 20px;min-height:46px;cursor:pointer;text-decoration:none}select{font:inherit;min-height:44px;max-width:100%}button:disabled{opacity:.5}button:focus-visible,a:focus-visible,select:focus-visible{outline:3px solid #9e5728;outline-offset:4px}#status{font-size:14px}#results{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:22px;margin:32px 0}#results article{padding:20px;background:#fff}#results img{width:100%;height:250px;object-fit:contain}#results a{display:block;margin-top:12px}#reset[hidden]{display:none}
</style>
