{
  "name": "ktb-scanner-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm build:library && pnpm assets && pnpm --filter @ktb/demo-next build && pnpm --filter @ktb/demo-astro build",
    "build:library": "pnpm --filter @ktb-tools/scanner build",
    "assets": "node scripts/copy-assets.mjs",
    "dev": "pnpm build:library && pnpm assets && pnpm --filter @ktb/demo-next dev",
    "dev:astro": "pnpm build:library && pnpm assets && pnpm --filter @ktb/demo-astro dev",
    "typecheck": "tsc --noEmit && pnpm --filter @ktb/demo-next typecheck",
    "lint": "prettier --check .github packages apps scripts tests package.json tsconfig.json tsconfig.core.json playwright.config.ts vitest.config.ts pnpm-workspace.yaml",
    "test": "vitest run",
    "test:core": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:release": "node --test scripts/release.test.mjs",
    "test:browser": "playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "check:notices": "node scripts/check-notices.mjs",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "licenses:inventory": "node scripts/licenses.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
